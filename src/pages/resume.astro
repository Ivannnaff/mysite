---
import Layout from "../layouts/Layout.astro";
import { translations } from "../translations";
import Footer from "../components/Footer.jsx";
const r = translations.en.resume;
---

<Layout title="Resume — Ivan Akbar">
    <main class="max-w-2xl mx-auto px-6 py-16">
        <div class="mb-12">
            <h1 class="text-2xl sm:text-3xl font-medium leading-tight tracking-tight text-fg mb-2">
                <span class="text-accent">Ivan</span> Akbar Alfahrezi
            </h1>
            <p class="text-base text-muted mb-4">{r.role}</p>
            <div class="flex flex-wrap gap-x-4 gap-y-1.5 text-sm text-muted font-mono">
                <span>{r.location}</span>
                <a
                    href={`mailto:${r.email}`}
                    class="hover:text-accent transition-colors"
                >
                    {r.email}
                </a>
                <a
                    href={`https://${r.github}`}
                    target="_blank"
                    rel="noreferrer"
                    class="hover:text-accent transition-colors"
                >
                    {r.github}
                </a>
            </div>
        </div>

        <section class="mb-12 pb-12 border-b border-border">
            <h2 class="font-mono text-[10px] uppercase tracking-widest text-muted mb-4">
                Profile
            </h2>
            <p class="text-fg/90 leading-relaxed">{r.summary}</p>
        </section>

        <section class="mb-12 pb-12 border-b border-border">
            <h2 class="font-mono text-[10px] uppercase tracking-widest text-muted mb-8">
                Experience
            </h2>
            <div class="space-y-8">
                {r.experience.map((exp) => (
                    <div>
                        <div class="flex items-baseline justify-between gap-4 mb-1">
                            <h3 class="font-medium text-fg">{exp.role}</h3>
                            <span class="font-mono text-xs text-muted shrink-0">
                                {exp.period}
                            </span>
                        </div>
                        <p class="text-sm text-accent mb-3">{exp.company}</p>
                        <div class="space-y-2">
                            {exp.points.map((point) => (
                                <p class="text-sm text-muted leading-relaxed pl-4 border-l-2 border-border">
                                    {point}
                                </p>
                            ))}
                        </div>
                    </div>
                ))}
            </div>
        </section>

        <section class="mb-12 pb-12 border-b border-border">
            <h2 class="font-mono text-[10px] uppercase tracking-widest text-muted mb-6">
                Skills
            </h2>
            <div class="space-y-3">
                {[
                    { label: "Languages", items: r.skills.languages },
                    { label: "Frontend", items: r.skills.frontend },
                    { label: "Backend", items: r.skills.backend },
                    { label: "Tools", items: r.skills.tools },
                ].map((group) => (
                    <div class="flex gap-6 items-baseline">
                        <span class="w-20 shrink-0 font-mono text-[10px] uppercase tracking-wider text-muted">
                            {group.label}
                        </span>
                        <p class="text-sm text-muted">
                            {group.items.join(" · ")}
                        </p>
                    </div>
                ))}
            </div>
        </section>
    </main>
    <Footer client:only="react" />
</Layout>
