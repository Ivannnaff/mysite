---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm.jsx";
import Footer from "../components/Footer.jsx";
---

<Layout title="Contact — Ivan Akbar">
    <main class="max-w-2xl mx-auto px-6 py-16">
        <div class="mb-10">
            <h1 class="text-xl sm:text-2xl font-medium leading-tight tracking-tight mb-2">
                Contact
            </h1>
            <p class="text-sm text-muted leading-relaxed">
                Get in touch or send a message directly.
            </p>
        </div>

        <div class="space-y-4 mb-12">
            {[
                {
                    label: "Email",
                    href: "mailto:ivanalfa647@gmail.com",
                    display: "ivanalfa647@gmail.com",
                },
                {
                    label: "GitHub",
                    href: "https://github.com/Ivannnaff",
                    display: "github.com/Ivannnaff",
                    external: true,
                },
                {
                    label: "LinkedIn",
                    href: "https://linkedin.com/in/IvanAkbarAlfahrezi",
                    display: "linkedin.com/in/IvanAkbarAlfahrezi",
                    external: true,
                },
                {
                    label: "Instagram",
                    href: "https://instagram.com/ivannnaff",
                    display: "instagram.com/ivannnaff",
                    external: true,
                },
            ].map((item) => (
                <div class="flex items-center justify-between py-2 border-b border-border">
                    <span class="text-sm text-muted">{item.label}</span>
                    <a
                        href={item.href}
                        {...(item.external
                            ? { target: "_blank", rel: "noreferrer" }
                            : {})}
                        class="inline-flex items-center gap-1 text-sm text-fg hover:text-accent transition-colors font-medium"
                    >
                        {item.display} ↗
                    </a>
                </div>
            ))}
        </div>

        <hr class="my-10 border-border" />

        <div class="mb-8">
            <h2 class="text-base font-medium text-fg mb-1">Send a message</h2>
            <p class="text-sm text-muted">Fill out the form below and it will open your mail client with your message.</p>
        </div>

        <ContactForm client:load />
    </main>
    <Footer client:only="react" />
</Layout>
