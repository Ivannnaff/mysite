---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.jsx';
import { translations } from '../translations';

const lang = typeof window !== 'undefined' ? localStorage.getItem('lang') || 'en' : 'en';
const t = translations[lang] || translations.en;
const c = t.colophon;
---

<Layout title={`${c.title} — Ivan Akbar`}>
  <main class="max-w-2xl mx-auto px-6 py-16">
    <div class="mb-12">
      <h1 class="text-2xl sm:text-3xl font-medium leading-tight tracking-tight mb-3">
        {c.title}
      </h1>
      <p class="max-w-[70ch] text-base text-muted leading-relaxed">
        {c.desc}
      </p>
    </div>

    <section class="mb-16">
      <h2 class="font-mono text-[10px] uppercase tracking-[0.2em] text-muted mb-8">
        {c.built}
      </h2>
      <div class="divide-y divide-border">
        <div class="grid gap-1 py-6 sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-8">
          <p class="font-medium text-sm text-fg">{c.framework}</p>
          <p class="text-sm text-muted leading-relaxed">{c.frameworkDesc}</p>
        </div>
        <div class="grid gap-1 py-6 sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-8">
          <p class="font-medium text-sm text-fg">{c.styling}</p>
          <p class="text-sm text-muted leading-relaxed">{c.stylingDesc}</p>
        </div>
        <div class="grid gap-1 py-6 sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-8">
          <p class="font-medium text-sm text-fg">{c.language}</p>
          <p class="text-sm text-muted leading-relaxed">{c.languageDesc}</p>
        </div>
        <div class="grid gap-1 py-6 sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-8">
          <p class="font-medium text-sm text-fg">{c.backend}</p>
          <p class="text-sm text-muted leading-relaxed">{c.backendDesc}</p>
        </div>
        <div class="grid gap-1 py-6 sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-8">
          <p class="font-medium text-sm text-fg">{c.content}</p>
          <p class="text-sm text-muted leading-relaxed">{c.contentDesc}</p>
        </div>
      </div>
    </section>

    <section>
      <h2 class="font-mono text-[10px] uppercase tracking-[0.2em] text-muted mb-8">
        {c.inspiration}
      </h2>
      <ul class="space-y-3">
        {c.inspirationList.map((site) => (
          <li>
            <a href={site.url} target="_blank" rel="noreferrer" class="text-sm text-muted hover:text-accent transition-colors underline underline-offset-4">
              {site.name}
            </a>
          </li>
        ))}
      </ul>
    </section>
  </main>

  <Footer client:only="react" />
</Layout>