---
import Layout from "../layouts/Layout.astro";
import { translations } from "../translations";
import { siteData } from "../data/siteData";
import ListeningSection from "../components/ListeningSection.jsx";
import Footer from "../components/Footer.jsx";
const t = translations.en;
---

<Layout title="Now — Ivan Akbar">
    <main class="max-w-2xl mx-auto px-6 py-16">
        <h1 class="text-xl sm:text-2xl font-medium leading-tight tracking-tight mb-2">
            {t.now.title}
        </h1>

        <p class="max-w-[70ch] text-sm leading-relaxed text-muted">
            {t.now.subtitle}
        </p>

        <p class="mt-6 font-mono text-xs text-muted">
            <span
                class="mr-2 inline-block h-2 w-2 rounded-full bg-accent"
                aria-hidden="true"
            ></span>
            {t.now.lastUpdated}
        </p>

        <hr class="my-12 border-border" />

        <div class="divide-y divide-border">
            {/* Focus */}
            <section class="grid gap-3 py-8 sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-8">
                <p class="pt-0.5 font-mono text-xs text-muted">{t.now.focus}</p>
                <div>
                    <h2 class="scroll-mt-24 text-base font-medium text-fg">
                        {t.now.focusHeading}
                    </h2>
                    <p class="mt-2 max-w-[70ch] text-sm leading-relaxed text-muted">
                        {t.now.focusDesc}
                    </p>
                </div>
            </section>

            {/* Building */}
            <section class="grid gap-3 py-8 sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-8">
                <p class="pt-0.5 font-mono text-xs text-muted">
                    {t.now.building}
                </p>
                <div>
                    <h2 class="scroll-mt-24 text-base font-medium text-fg">
                        {t.now.buildingHeading}
                    </h2>
                    <p class="mt-2 max-w-[70ch] text-sm leading-relaxed text-muted">
                        {t.now.buildingDesc}
                    </p>
                    <div class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-sm">
                        {siteData.projects.map((project) => (
                            <a
                                key={project.name}
                                href={project.url}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="inline-flex items-center gap-1 underline decoration-accent/50 underline-offset-4 transition-colors hover:text-accent"
                            >
                                {project.name}
                                <svg
                                    width="1em"
                                    height="1em"
                                    viewBox="0 0 24 24"
                                    class="h-3 w-3"
                                    aria-hidden="true"
                                >
                                    <path
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M7 7h10v10M7 17L17 7"
                                    />
                                </svg>
                            </a>
                        ))}
                    </div>
                </div>
            </section>

            {/* Learning */}
            <section class="grid gap-3 py-8 sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-8">
                <p class="pt-0.5 font-mono text-xs text-muted">
                    {t.now.learning}
                </p>
                <div>
                    <h2 class="scroll-mt-24 text-base font-medium text-fg">
                        {t.now.learningHeading}
                    </h2>
                    <p class="mt-2 max-w-[70ch] text-sm leading-relaxed text-muted">
                        {t.now.learningDesc}
                    </p>
                    <ul class="mt-6 space-y-5">
                        {t.now.learningList.map((item) => (
                            <li key={item.title}>
                                <div class="flex flex-wrap items-baseline gap-x-2">
                                    <p class="text-sm font-medium text-fg">
                                        {item.title}
                                    </p>
                                    <span class="font-mono text-xs text-muted">
                                        · since {item.since}
                                    </span>
                                </div>
                                <p class="mt-1 max-w-[70ch] text-sm leading-relaxed text-muted">
                                    {item.desc}
                                </p>
                            </li>
                        ))}
                    </ul>
                </div>
            </section>

            {/* Listening */}
            <section class="grid gap-3 py-8 sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-8">
                <p class="pt-0.5 font-mono text-xs text-muted">
                    {t.now.listeningLabel}
                </p>
                <div>
                    <h2 class="scroll-mt-24 text-base font-medium text-fg">
                        {t.now.listening.title}
                    </h2>
                    <ListeningSection
                        empty={t.now.listening.empty}
                        client:load
                    />
                </div>
            </section>

            {/* Open to */}
            <section class="grid gap-3 py-8 sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-8">
                <p class="pt-0.5 font-mono text-xs text-muted">
                    {t.now.openTo}
                </p>
                <div>
                    <h2 class="scroll-mt-24 text-base font-medium text-fg">
                        {t.now.openToHeading}
                    </h2>
                    <ul class="mt-4 space-y-2 text-sm text-muted">
                        {t.now.openToList.map((item) => (
                            <li key={item}>{item}</li>
                        ))}
                    </ul>
                </div>
            </section>
        </div>

        <p class="mt-12 text-xs text-muted">{t.now.handwritten}</p>
    </main>
    <Footer client:only="react" />
</Layout>
